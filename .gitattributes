# Normalize text files to LF on every platform so line-ending-sensitive
# checks (documented markers, recorded digests) behave identically in CI.
* text=auto eol=lf

# Binary assets stay byte-for-byte identical on every platform.
*.sf2 binary
*.ttf binary
*.otf binary
*.mid binary
*.raw binary
*.png binary
*.jpg binary
*.jpeg binary
*.flac binary
*.ogg binary
*.wav binary
*.au binary
# Additional binary formats used by the project (git's content heuristic would
# otherwise decide, which makes -diff/-merge behaviour unpredictable).
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.mp3 binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.midi binary
*.sf3 binary
*.sfz binary

# The fixtures tree also holds *text* fixtures (MANIFEST.sha256, *.log, *.tsv,
# *.xml, *.meta, *.json, *.md). Those must stay LF-normalized: a CRLF copy on
# one platform would change every recorded digest, which is exactly what the
# rules above exist to prevent.
fixtures/**/*.sha256 text eol=lf
fixtures/**/*.md text eol=lf
fixtures/**/*.tsv text eol=lf
fixtures/**/*.log text eol=lf
fixtures/**/*.xml text eol=lf
fixtures/**/*.meta text eol=lf
fixtures/**/*.json text eol=lf
fixtures/**/*.txt text eol=lf
fixtures/**/*.csv text eol=lf
