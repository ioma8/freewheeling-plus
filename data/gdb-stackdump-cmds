set pagination off
set height 0
set width 0
set confirm off
echo \n\n*** Stacktrace\n
where
echo \n\n*** Symbols\n
# `bt full` prints the arguments and locals of every frame, so the dump does
# not depend on a fixed frame count or a hard-coded starting frame.
bt full
echo \n*** Backtrace All Threads\n\n
thread apply all bt full
echo \n---
# Detaching must happen even when a command above failed.
detach
quit
