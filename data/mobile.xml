      </element>
      <element id="133" name="SAVE" base="0.7500,0.52" namepos="0.03,0.03">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.22"/>
      </element>
    </layout>
  </graphics>
</interface>
