<interface>
  <!-- Mobile (Android touch) layout: a 4x2 loop grid in the upper screen and
       four function buttons in the middle, above the input/output meters.
       The layout is the default on Android (see native_runtime start_session);
       on desktop it is available as an extra switchable interface.

       Loop grid: 8 large square cells, elements 'a'..'h' (ids 97..104).
       Tapping a cell triggers the loop (coreinterface's plain loop-clicked
       binding). Cells are square on a phone screen (0.25 of the width wide
       and 0.1217 of the height tall, i.e. 270 px x 270 px on a 1080 x 2219
       surface); the loop scope is centered in each cell at 0.20 of the
       screen width.

       Buttons (ids 130..133; the slot system only accepts loop ids below
       256, so the F-key keycodes 282/285/288 cannot be used as element ids):
         PULSE (130): create/select the pulse. While CLEAR is armed, deletes
           the pulse instead.
         CLEAR (131): latches erase mode (VAR_mobile_clear). While armed,
           tapping a grid loop erases it or tapping PULSE deletes the pulse;
           both actions disarm afterwards. Tapping CLEAR again toggles erase
           mode off.
         REC (132): start/stop stream recording to disk.
         SAVE (133): save the current scene.

       The button bindings live in coreinterface.xml before the generic
       loop-clicked trigger so they take precedence; they are inert on
       desktop, where no layout element carries these ids. -->

  <bindings>
    <declare var="VAR_mobile_clear" type="char" init="0"/>
    <!-- Loops are shown from base 0, so a layout element's id IS its loop
         id: cells 97..104 map to loops 97..104 (the same ids the PC keyboard
         interface uses), and the buttons use 130..133. -->
    <declare var="VAR_mobilerange" type="range" init="0>322"/>

    <!-- Startup: show loops on the mobile grid. -->
    <binding input="start-interface"
     output1="video-show-loop"
     parameters1="layoutid=0 and loopid=VAR_mobilerange"/>
  </bindings>

  <graphics>
    <layout id="0" name="Mobile Loops" scale="1.0,1.0" pos="0.00,0.00"
     label="0" elabel="1" show="0">
      <!-- 4 x 2 loop grid. Each cell is 1/4 of the width and 1/4 of the
           width in height (square on a phone screen): 0.25 x 0.1217. -->
      <element id="97" name="A" base="0.0000,0.0400" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="98" name="B" base="0.2500,0.0400" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="99" name="C" base="0.5000,0.0400" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="100" name="D" base="0.7500,0.0400" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="101" name="E" base="0.0000,0.1617" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="102" name="F" base="0.2500,0.1617" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="103" name="G" base="0.5000,0.1617" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="104" name="H" base="0.7500,0.1617" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>

      <!-- Function buttons, between the grid and the input/output meters
           (which occupy the bottom 20% on Android). Square, 0.22 x 0.22. -->
      <element id="130" name="PULSE" base="0.0300,0.3900" namepos="0.03,0.03" toggle="pulse-active">
        <box outline="TBLR" pos="0.00,0.00, 0.22,0.22"/>
      </element>
      <element id="131" name="CLEAR" base="0.2700,0.3900" namepos="0.03,0.03" toggle="VAR_mobile_clear">
        <box outline="TBLR" pos="0.00,0.00, 0.22,0.22"/>
      </element>
      <element id="132" name="REC" base="0.5100,0.3900" namepos="0.03,0.03" toggle="streaming">
        <box outline="TBLR" pos="0.00,0.00, 0.22,0.22"/>
      </element>
      <element id="133" name="SAVE" base="0.7500,0.3900" namepos="0.03,0.03">
        <box outline="TBLR" pos="0.00,0.00, 0.22,0.22"/>
      </element>
    </layout>
  </graphics>
</interface>
