      <!-- Function buttons, above the input/output meters (which occupy the
           bottom 20% on Android). -->
      <element id="130" name="PULSE" base="0.0000,0.52" namepos="0.03,0.03">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.22"/>
      </element>
      <element id="131" name="CLEAR" base="0.2500,0.52" namepos="0.03,0.03">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.22"/>
      </element>
      <element id="132" name="REC" base="0.5000,0.52" namepos="0.03,0.03">
