<interface>
  <!-- Mobile (Android touch) layout set: a 4x3 loop grid in the upper screen,
       five function buttons beneath it, and a saved-sessions panel.
       The layout is the default on Android (see native_runtime start_session);
       on desktop it is available as an extra switchable interface.

       Loop grid (layout 0): 12 large square cells, elements 'a'..'l'
       (ids 97..108). Gestures per cell:
         tap          -> record / play / stop (generic loop-clicked trigger)
         long-press   -> overdub (hold starts, release stops)
         double-tap   -> mute/unmute
         drag up/down -> loop gain (like the desktop scrollwheel)
       Cells are square on a phone screen (0.25 of the width wide and 0.1217
       of the height tall); the loop scope is centered at 0.20 of the width.

       Buttons (ids 130..134; the slot system only accepts loop ids below
       256, so the F-key keycodes 282/285/288 cannot be used as element ids):
         PULSE (130): create/select the pulse. While CLEAR is armed, deletes
           the pulse instead.
         CLEAR (131): latches erase mode (VAR_mobile_clear). While armed,
           tapping a grid loop erases it or tapping PULSE deletes the pulse;
           both actions disarm afterwards.
         REC (132): start/stop stream recording to disk.
         SAVE (133): save the current scene.
         LOAD (134): open the saved-sessions panel (layout 1).

       Sessions panel (layout 1): the five most recent saved scenes (by
       modification time) plus CLOSE. Tapping a row loads that session.

       The button/gesture/session bindings live in coreinterface.xml before
       the generic loop-clicked trigger so they take precedence; the gesture
       button codes 2/6 are unreachable on desktop. -->

  <bindings>
    <declare var="VAR_mobile_clear" type="char" init="0"/>
    <!-- Loops are shown from base 0, so a layout element's id IS its loop
         id: cells 97..108 map to loops 97..108 (the same ids the PC keyboard
         interface uses), and the buttons use 130..134. -->
    <declare var="VAR_mobilerange" type="range" init="0>322"/>

    <!-- Startup: show loops on the mobile grid. -->
    <binding input="start-interface"
     output1="video-show-loop"
     parameters1="layoutid=0 and loopid=VAR_mobilerange"/>
  </bindings>

  <graphics>
    <layout id="0" name="Mobile Loops" scale="1.0,1.0" pos="0.00,0.00"
     label="0" elabel="1" show="0" emptyhint="tap a cell to record">
      <!-- 4 x 3 loop grid. Each cell is 1/4 of the width and 1/4 of the
           width in height (square on a phone screen): 0.25 x 0.1217. -->
      <element id="97" name="A" base="0.0000,0.0400" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="98" name="B" base="0.2500,0.0400" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="99" name="C" base="0.5000,0.0400" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="100" name="D" base="0.7500,0.0400" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="101" name="E" base="0.0000,0.1617" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="102" name="F" base="0.2500,0.1617" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="103" name="G" base="0.5000,0.1617" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="104" name="H" base="0.7500,0.1617" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="105" name="I" base="0.0000,0.2834" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="106" name="J" base="0.2500,0.2834" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="107" name="K" base="0.5000,0.2834" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>
      <element id="108" name="L" base="0.7500,0.2834" looppos="0.1250,0.0608" loopsize="0.20" namepos="0.008,0.005">
        <box outline="TBLR" pos="0.00,0.00, 0.25,0.1217"/>
      </element>

      <!-- Function buttons, between the grid and the input/output meters
           (which occupy the bottom 20% on Android). Square in screen pixels:
           0.16 of the width wide and 0.16 * aspect tall (~173 px). -->
      <element id="130" name="PULSE" base="0.0300,0.5200" toggle="pulse-active" labelcenter="1">
        <box outline="TBLR" pos="0.00,0.00, 0.16,0.0790"/>
      </element>
      <element id="131" name="CLEAR" base="0.2100,0.5200" toggle="VAR_mobile_clear" labelcenter="1">
        <box outline="TBLR" pos="0.00,0.00, 0.16,0.0790"/>
      </element>
      <element id="132" name="REC" base="0.3900,0.5200" toggle="streaming" labelcenter="1">
        <box outline="TBLR" pos="0.00,0.00, 0.16,0.0790"/>
      </element>
      <element id="133" name="SAVE" base="0.5700,0.5200" toggle="scene-save-age" togglemax="0.6" labelcenter="1">
        <box outline="TBLR" pos="0.00,0.00, 0.16,0.0790"/>
      </element>
      <element id="134" name="LOAD" base="0.7500,0.5200" labelcenter="1">
        <box outline="TBLR" pos="0.00,0.00, 0.16,0.0790"/>
      </element>
    </layout>

    <!-- Saved-sessions panel: shown by LOAD, each row loads the N-th most
         recent scene (browser index N), CLOSE hides the panel. -->
    <layout id="1" name="Sessions" scale="1.0,1.0" pos="0.00,0.00"
     label="1" elabel="1" show="0" namepos="0.05,0.02">
      <element id="199" name="" base="0.0000,0.0000">
        <box outline="TBLR" pos="0.00,0.00, 1.00,0.65"/>
      </element>
      <element id="200" name="1" base="0.0500,0.0900" labelcenter="1">
        <box outline="TBLR" pos="0.00,0.00, 0.90,0.07"/>
      </element>
      <element id="201" name="2" base="0.0500,0.1750" labelcenter="1">
        <box outline="TBLR" pos="0.00,0.00, 0.90,0.07"/>
      </element>
      <element id="202" name="3" base="0.0500,0.2600" labelcenter="1">
        <box outline="TBLR" pos="0.00,0.00, 0.90,0.07"/>
      </element>
      <element id="203" name="4" base="0.0500,0.3450" labelcenter="1">
        <box outline="TBLR" pos="0.00,0.00, 0.90,0.07"/>
      </element>
      <element id="204" name="5" base="0.0500,0.4300" labelcenter="1">
        <box outline="TBLR" pos="0.00,0.00, 0.90,0.07"/>
      </element>
      <element id="205" name="CLOSE" base="0.4000,0.5400" labelcenter="1">
        <box outline="TBLR" pos="0.00,0.00, 0.20,0.07"/>
      </element>
    </layout>
  </graphics>
</interface>
