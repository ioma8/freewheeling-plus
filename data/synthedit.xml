<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <bindings>
    <!-- Variables -->

    <declare var="DISPLAY_synthedit" type="int" init="1000"/>
    <declare var="DISPLAY_synthedit_chanselect" type="int" init="1001"/>
    
    <declare var="VAR_synthedit_interfaceid" type="int" init="0"/>
    
    <!-- SynthEdit current MIDI channel -->
    <declare var="VAR_synthedit_midichannel" type="int" init="0"/> 
   
    <!-- Startup -->
    <binding input="start-interface" 
     output1="set-variable"
     parameters1="var=VAR_synthedit_interfaceid and value=interfaceid"/>
  </bindings>
  
  <graphics>
    <!-- The SynthEdit MIDI channel is a configuration value
         (data/basics.xml `fluidsynth channel` and the nk variable below);
         no binding in this interface rewrites it, so the display shows the
         configured channel rather than a selectable one. -->
    <display id="DISPLAY_synthedit_chanselect" show="0" var="VAR_synthedit_midichannel" type="text" font="small" title="SynthEdit Ch " pos="0.05,0.07"/>
    <display id="DISPLAY_synthedit" show="0"
     type="paramset" font="tiny" pos="0.05,0.1" size="0.9,0.22" 
     name="synthedit" title="Synth Editor" numactiveparams="8">
      <!-- The bank holds two pages of 8 parameters (matching the BCF-2000's
           eight motor faders in bcf2000-synthedit.xml): the 10 named CS-80
           parameters plus 6 placeholders, so paging never lands on a page of
           blank rows and the absolute indices used for NRPN addressing stay
           within the parameter set. -->
      <bank name="CS-80" maxvalue="127">
        <param name="*S1* LFO SPD"/>
        <param name="PWM LFO %"/>
        <param name="PWM BASE"/>
        <param name="NOISE"/>
        <param name="HI FLT"/>
        <param name="HI REZ"/>
        <param name="LO FLT"/>
        <param name="LO REZ"/>
        <param name="LVL"/>
        <param name="OSC SINE"/>
        <param/>
        <param/>
        <param/>
        <param/>
        <param/>
        <param/>
</bank>
    </display> 
  </graphics>
</interface>
